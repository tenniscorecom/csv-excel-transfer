{
  // comken の場所を VS Code に教える。ここを書かないと補完も「定義へ移動」も効かず、
  // 型チェッカーが comken 由来の型を Unknown 扱いして無関係な警告を並べる。
  // （実行.bat は動かすときだけ PYTHONPATH を設定するので、編集中の VS Code には別途この指定が要る）
  //
  // 実行.bat の PYTHON_LIBRARY と同じ場所を指すこと。
  // JSON では \ が特殊文字なので、区切りは / で書く（\\server\share → //server/share）。
  // 社内へ配置したら、その配置先も配列に足す。存在しない方は無視されるので両方書いてよい。
  "python.analysis.extraPaths": ["F:/dev/comken"],

  // 社内 BO 環境には .venv が無い（pip が使えないため）。
  // その場合はこの指定が外れるので、VS Code 右下の Python バージョン表示をクリックして
  // 社内標準の Python を選ぶ。自宅など .venv を作れる環境ではそのまま使える。
  "python.defaultInterpreterPath": ".venv/Scripts/python.exe",

  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.ruff": "explicit",
      "source.organizeImports.ruff": "explicit"
    }
  },
  "ruff.enable": true,

  // pyproject.toml の line-length と揃える
  "editor.rulers": [100],

  // テストは pytest。VS Code のテストパネルから実行できるようにする
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.pytestArgs": ["tests"],

  // bat は CP932 で保存する（cmd.exe が CP932 として読むため。UTF-8 だと日本語が化ける）
  "[bat]": {
    "files.encoding": "shiftjis"
  }
}
